module WinRT [system] {
  link "WindowsApp.lib"
  export *

  module AsyncInfo {
    header "asyncinfo.h"
    export *
  }

  module Base {
    header "WinRTBase.h"
    export *
  }

  module EventToken {
    header "EventToken.h"
    export *
  }

  module hstring {
    header "hstring.h"
    export *
  }

  module RoAPI {
    header "roapi.h"
    export *
  }

  module VectorChangedEventArgs {
    header "ivectorchangedeventargs.h"
    export *
  }

  module WinString {
    header "winstring.h"
    export *
  }

  header "winrt-shims.h"
}

module WindowsFoundation {
  header "windows.foundation.h"
  export *
}

module WindowsUI {
  module XAML {
    header "windows.ui.xaml.controls.h"
    header "windows.ui.xaml.hosting.h"
    export *
  }
}
